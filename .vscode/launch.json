{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 PR 评审",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/index.js",
      "args": ["ZM App", "161"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "调试项目查询",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/test-project-search.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "调试健康检查",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/utils/health-check.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "调试配置验证",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/utils/validate-config.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "附加到运行中的进程",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
