{
  "name": "pr-review-automation",
  "version": "2.1.0",
  "description": "GitLab MR自动化评审工具，支持AI智能分析和Flutter专项检查",
  "type": "module",
  "main": "pr-reviewer.js",
  "scripts": {
    "start": "node pr-reviewer.js",
    "review": "node pr-reviewer.js",
    "test": "echo \"暂无测试\" && exit 0",
    "check-config": "node -e \"import('./config-loader.js').then(({configLoader}) => configLoader.loadConfig().then(config => console.log('配置验证通过')).catch(err => { console.error('配置错误:', err.message); process.exit(1); }))\"",
    "check-feishu": "node check-feishu.js",
    "setup": "npm install && echo '请编辑 config.json 文件配置项目信息'",
    "dev": "DEBUG=true node pr-reviewer.js"
  },
  "keywords": [
    "gitlab",
    "merge-request",
    "code-review",
    "automation",
    "ai-analysis",
    "flutter",
    "dart"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "dependencies": {
    "@gitbeaker/rest": "^43.3.0",
    "openai": "^4.0.0",
    "node-fetch": "^3.3.0"
  },
  "bin": {
    "pr-reviewer": "./pr-reviewer.js"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/pr-review-automation.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/pr-review-automation/issues"
  },
  "homepage": "https://github.com/your-username/pr-review-automation#readme"
}
