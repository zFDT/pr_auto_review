{
  "gitlab": {
    "host": "https://git.dreame.tech",
    "token": "${GITLAB_TOKEN}"
  },
  "projects": {
    "ZM App": {
      "id": 9831,
      "description": "ZM应用主项目"
    },
    "StaticRelease": {
      "id": 161,
      "description": "StaticRelease项目"
    },
    "android-3d-preliminary-research": {
      "id": 10444,
      "description": "Android 3D初步研究项目"
    }
  },
  "review_settings": {
    "max_files_warning": 20,
    "max_lines_warning": 1000,
    "include_detailed_diff": false,
    "check_console_logs": true,
    "check_todos": true,
    "enable_ai_analysis": true,
    "ai_provider": "aliyun_bailian",
    "exclude_patterns": [
      "*.min.js",
      "*.min.css",
      "node_modules/*",
      "dist/*",
      "build/*",
      ".git/*",
      "*.log",
      "*.lock",
      "package-lock.json",
      "yarn.lock",
      "*.map",
      "*.svg",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.eot"
    ],
    "max_file_size": 100000
  },
  "ai_config": {
    "_comment": "AI模型配置说明请参考 AI_MODELS_GUIDE.md",
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "model": "gpt-4o",
      "base_url": "https://api.openai.com/v1",
      "max_tokens": 4000,
      "temperature": 0.1,
      "timeout": 60000
    },
    "copilot": {
      "enabled": false,
      "vscode_path": "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code",
      "timeout": 60000,
      "fallback_to_openai": true
    },





    "aliyun_bailian": {
      "api_key": "your_openai_api_key_here",
      "model": "qwen-max",
      "workspace_id": "your_aliyun_workspace_id",
      "base_url": "https://dashscope.aliyuncs.com/api/v1",
      "timeout": 600000,
      "max_tokens": 8192,
      "temperature": 0.1
    },
    "review_prompts": {
      "_note": "Review提示词配置已迁移到统一的review-standards-config.json",
      "config_file": "review-standards-config.json",
      "use_unified_standards": true,
      "legacy_system_prompt": "你是一个专业的代码审查专家，专注于Flutter/Dart、JavaScript/TypeScript、Java、Python等语言的代码质量分析。",
      "legacy_analysis_focus": [
        "代码质量和最佳实践",
        "潜在的bug和逻辑错误", 
        "安全漏洞和风险点",
        "性能优化建议",
        "代码可维护性和可读性",
        "架构设计合理性"
      ]
    }
  },
  "notification": {
    "feishu": {
      "webhook_url": "${FEISHU_WEBHOOK_URL}",
      "enabled": true
    }
  }
}
