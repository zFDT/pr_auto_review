{
  "gitlab": {
    "host": "https://git.dreame.tech",
    "token": "${GITLAB_TOKEN}"
  },
  "_projects_comment": "projects配置是可选的，作为API查询的备选方案。系统会优先通过GitLab API获取最新项目信息，只有API查询失败时才使用此配置",
  "projects": {
    "ZM App": {
      "id": 9831,
      "description": "ZM应用主项目"
    },
    "StaticRelease": {
      "id": 161,
      "description": "StaticRelease项目"
    },
    "android-3d-preliminary-research": {
      "id": 10444,
      "description": "Android 3D初步研究项目"
    }
  },
  "review_settings": {
    "max_files_warning": 20,
    "max_lines_warning": 1000,
    "include_detailed_diff": false,
    "check_console_logs": true,
    "check_todos": true,
    "enable_ai_analysis": true,
    "ai_provider": "aliyun_bailian",
    "exclude_patterns": [
      "*.min.js",
      "*.min.css",
      "node_modules/*",
      "dist/*",
      "build/*",
      ".git/*",
      "*.log",
      "*.lock",
      "package-lock.json",
      "yarn.lock",
      "*.map",
      "*.svg",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.ico",
      "*.woff",
      "*.woff2",
      "*.ttf",
      "*.eot"
    ],
    "max_file_size": 100000
  },
  "ai_config": {
    "_comment": "AI模型配置说明请参考 AI_MODELS_GUIDE.md",
    "openai": {
      "api_key": "${OPENAI_API_KEY}",
      "model": "gpt-4o",
      "base_url": "https://api.openai.com/v1",
      "maxTokens": 4096,
      "temperature": 0.1,
      "timeout": 600000,
      "maxConcurrency": 6,
      "maxRetries": 2,
      "retryDelay": 500,
      "enableCache": false
    },
    "copilot": {
      "enabled": false,
      "vscode_path": "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code",
      "timeout": 600000,
      "fallback_to_openai": false,
      "maxConcurrency": 4,
      "maxRetries": 1,
      "enableCache": false
    },
    "aliyun_bailian": {
      "api_key": "your_openai_api_key_here",
      "model": "deepseek-r1",
      "workspace_id": "your_aliyun_workspace_id",
      "base_url": "https://dashscope.aliyuncs.com/api/v1",
      "timeout": 600000,
      "maxTokens": 8192,
      "temperature": 0.1,
      "maxConcurrency": 10,
      "maxRetries": 3,
      "retryDelay": 1000,
      "enableCache": false
    }
  },
  "notification": {
    "feishu": {
      "webhook_url": "${FEISHU_WEBHOOK_URL}",
      "enabled": true
    }
  }
}