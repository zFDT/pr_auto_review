{
  "review_focus": {
    "code_quality_and_structure": {
      "enabled": true,
      "weight": 20,
      "checks": {
        "architecture_patterns": {
          "enabled": true,
          "patterns": ["MVVM", "BLoC", "Provider", "Riverpod", "GetX"],
          "description": "检查是否遵循推荐的架构模式"
        },
        "file_organization": {
          "enabled": true,
          "structure_rules": [
            "lib/models/",
            "lib/views/",
            "lib/controllers/",
            "lib/services/",
            "lib/utils/",
            "lib/widgets/"
          ],
          "description": "确保文件按功能模块合理组织"
        },
        "code_reuse": {
          "enabled": true,
          "duplicate_threshold": 10,
          "description": "查看是否有重复代码，建议提取公共组件"
        },
        "naming_conventions": {
          "enabled": true,
          "rules": {
            "variables": "camelCase",
            "functions": "camelCase",
            "classes": "PascalCase",
            "constants": "SCREAMING_SNAKE_CASE",
            "files": "snake_case"
          },
          "description": "检查命名规范是否符合Dart约定"
        }
      }
    },
    "flutter_specific_checks": {
      "enabled": true,
      "weight": 25,
      "checks": {
        "widget_design": {
          "enabled": true,
          "rules": [
            "正确使用StatelessWidget和StatefulWidget",
            "Widget复杂度控制，建议拆分大组件",
            "合理使用const构造函数优化性能",
            "避免深层嵌套Widget"
          ],
          "description": "Widget设计最佳实践检查"
        },
        "state_management": {
          "enabled": true,
          "supported_patterns": ["Provider", "BLoC", "Riverpod", "setState", "GetX"],
          "description": "检查状态管理方案使用是否合理"
        },
        "lifecycle_management": {
          "enabled": true,
          "checks": [
            "正确处理initState和dispose",
            "Stream和AnimationController的资源释放",
            "页面生命周期管理"
          ],
          "description": "确保正确处理Widget和State生命周期"
        },
        "navigation_management": {
          "enabled": true,
          "checks": [
            "路由跳转规范性",
            "返回数据处理",
            "导航栈管理"
          ],
          "description": "导航管理检查"
        }
      }
    },
    "performance_optimization": {
      "enabled": true,
      "weight": 20,
      "checks": {
        "build_optimization": {
          "enabled": true,
          "rules": [
            "避免在build方法中进行复杂计算",
            "合理使用const关键字",
            "检查不必要的Widget重建"
          ],
          "description": "构建性能优化检查"
        },
        "memory_management": {
          "enabled": true,
          "checks": [
            "Stream资源释放",
            "AnimationController释放",
            "监听器取消订阅",
            "内存泄漏风险检查"
          ],
          "description": "内存管理检查"
        },
        "list_rendering": {
          "enabled": true,
          "rules": [
            "长列表使用ListView.builder",
            "合理使用itemExtent",
            "避免全量渲染大数据集"
          ],
          "description": "列表渲染优化"
        }
      }
    },
    "ui_ux_consistency": {
      "enabled": true,
      "weight": 15,
      "checks": {
        "design_compliance": {
          "enabled": true,
          "description": "UI实现是否符合设计规范"
        },
        "responsive_layout": {
          "enabled": true,
          "breakpoints": ["mobile", "tablet", "desktop"],
          "description": "响应式布局检查"
        },
        "theme_usage": {
          "enabled": true,
          "checks": [
            "正确使用Theme数据",
            "颜色方案一致性",
            "字体样式规范"
          ],
          "description": "主题使用规范检查"
        },
        "internationalization": {
          "enabled": true,
          "description": "多语言支持检查（如需要）"
        }
      }
    },
    "error_handling_and_stability": {
      "enabled": true,
      "weight": 20,
      "checks": {
        "exception_handling": {
          "enabled": true,
          "areas": [
            "网络请求错误处理",
            "文件操作异常",
            "用户输入验证",
            "异步操作错误"
          ],
          "description": "异常处理完整性检查"
        },
        "null_safety": {
          "enabled": true,
          "rules": [
            "正确使用空安全特性",
            "避免强制非空操作",
            "合理使用?和!"
          ],
          "description": "Dart空安全特性使用检查"
        },
        "edge_cases": {
          "enabled": true,
          "scenarios": [
            "网络断开情况",
            "数据为空场景",
            "用户快速操作",
            "内存不足处理"
          ],
          "description": "边界情况处理检查"
        },
        "testing_coverage": {
          "enabled": true,
          "types": ["unit_test", "widget_test", "integration_test"],
          "description": "测试覆盖率检查"
        }
      }
    },
    "dependency_management": {
      "enabled": true,
      "weight": 10,
      "checks": {
        "pubspec_management": {
          "enabled": true,
          "rules": [
            "依赖版本合理性",
            "是否有未使用依赖",
            "依赖冲突检查"
          ],
          "description": "pubspec.yaml依赖管理检查"
        },
        "platform_specific": {
          "enabled": true,
          "platforms": ["android", "ios", "web", "desktop"],
          "description": "平台特定代码实现检查"
        },
        "permissions": {
          "enabled": true,
          "description": "权限配置正确性检查"
        }
      }
    },
    "code_standards": {
      "enabled": true,
      "weight": 15,
      "checks": {
        "linting": {
          "enabled": true,
          "tools": ["dart analyze", "flutter analyze"],
          "description": "代码规范检查工具验证"
        },
        "formatting": {
          "enabled": true,
          "tool": "dart format",
          "description": "代码格式化标准检查"
        },
        "documentation": {
          "enabled": true,
          "requirements": [
            "复杂逻辑注释",
            "公共API文档",
            "README更新"
          ],
          "description": "代码文档完整性检查"
        },
        "todo_management": {
          "enabled": true,
          "keywords": ["TODO", "FIXME", "HACK"],
          "description": "待完成事项管理"
        }
      }
    },
    "security_checks": {
      "enabled": true,
      "weight": 15,
      "checks": {
        "sensitive_data": {
          "enabled": true,
          "patterns": [
            "API密钥硬编码",
            "密码明文存储",
            "个人信息泄露"
          ],
          "description": "敏感数据安全检查"
        },
        "data_validation": {
          "enabled": true,
          "areas": [
            "用户输入验证",
            "数据清理",
            "SQL注入防护"
          ],
          "description": "数据验证安全检查"
        },
        "network_security": {
          "enabled": true,
          "checks": [
            "HTTPS使用",
            "证书验证",
            "安全传输"
          ],
          "description": "网络安全检查"
        }
      }
    },
    "commit_quality": {
      "enabled": true,
      "weight": 10,
      "checks": {
        "commit_message": {
          "enabled": true,
          "format": "conventional_commits",
          "description": "提交信息规范检查"
        },
        "change_scope": {
          "enabled": true,
          "principle": "single_responsibility",
          "description": "变更范围合理性检查"
        },
        "backward_compatibility": {
          "enabled": true,
          "description": "向后兼容性检查"
        }
      }
    },
    "documentation_updates": {
      "enabled": true,
      "weight": 5,
      "checks": {
        "readme_updates": {
          "enabled": true,
          "description": "README文档更新检查"
        },
        "api_documentation": {
          "enabled": true,
          "description": "API文档说明检查"
        },
        "changelog": {
          "enabled": true,
          "description": "变更日志记录检查"
        }
      }
    }
  },
  "output_settings": {
    "include_detailed_diff": false,
    "max_issues_per_category": 10,
    "severity_levels": ["critical", "major", "minor", "suggestion"],
    "report_format": "structured"
  }
}
