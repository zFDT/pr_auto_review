<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dreame.pr-review.file-server</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/pr-review-automation/file-server.sh</string>
        <string>start</string>
    </array>
    
    <key>WorkingDirectory</key>
    <string>/path/to/pr-review-automation</string>
    
    <key>RunAtLoad</key>
    <true/>
    
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    
    <key>StandardOutPath</key>
    <string>/path/to/pr-review-automation/launchd.log</string>
    
    <key>StandardErrorPath</key>
    <string>/path/to/pr-review-automation/launchd.error.log</string>
    
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>SERVER_PORT</key>
        <string>8899</string>
        <key>SERVER_HOST</key>
        <string>0.0.0.0</string>
    </dict>
    
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
